I0916 14:01:08.214481    3827 conn_opt.go:53] jsonrpc2: --> notif: textDocument/didChange: {"textDocument":{"uri":"file:///home/sshravyaharikant/templates/index.html","version":2},"contentChanges":[{"range":{"start":{"line":0,"character":0},"end":{"line":22,"character":10}},"rangeLength":877,"text":"\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"en\"\u003e\n\u003chead\u003e\n    \u003cmeta charset=\"UTF-8\"\u003e\n    \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"\u003e\n    \u003ctitle\u003eGCP ML Model Deployment | Codec Tech\u003c/title\u003e\n    \n    \u003c!-- Link to Custom CSS --\u003e\n    \u003clink rel=\"stylesheet\" href=\"{{ url_for('static', filename='style.css') }}\"\u003e\n    \n    \u003c!-- Google Font --\u003e\n    \u003clink href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700\u0026display=swap\" rel=\"stylesheet\"\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\n    \u003cheader class=\"app-header\"\u003e\n        \u003cdiv class=\"container\"\u003e\n            \u003ch1\u003eMachine Learning Model Deployment\u003c/h1\u003e\n            \u003cp class=\"subtitle\"\u003eCloud-Based REST API Service | Iris Species Classifier\u003c/p\u003e\n        \u003c/div\u003e\n    \u003c/header\u003e\n\n    \u003cmain class=\"app-main container\"\u003e\n        \u003cdiv class=\"main-content-layout\"\u003e\n            \n            \u003c!-- Left Side: Interactive Input Form --\u003e\n            \u003csection class=\"control-panel card\"\u003e\n                \u003ch2\u003ePredict Flower Species\u003c/h2\u003e\n                \u003cp\u003eEnter numerical measurements (cm) below for real-time inference.\u003c/p\u003e\n                \n                \u003cform action=\"/predict\" method=\"post\" class=\"ml-input-form\"\u003e\n                    \u003cdiv class=\"input-group\"\u003e\n                        \u003clabel for=\"sepal_length\"\u003eSepal Length (cm)\u003c/label\u003e\n                        \u003cinput type=\"number\" step=\"0.1\" name=\"sepal_length\" id=\"sepal_length\" placeholder=\"Enter value\" required value=\"{{ inputs.sepal_length if inputs else 5.1 }}\"\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class=\"input-group\"\u003e\n                        \u003clabel for=\"sepal_width\"\u003eSepal Width (cm)\u003c/label\u003e\n                        \u003cinput type=\"number\" step=\"0.1\" name=\"sepal_width\" id=\"sepal_width\" placeholder=\"Enter value\" required value=\"{{ inputs.sepal_width if inputs else 3.5 }}\"\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class=\"input-group\"\u003e\n                        \u003clabel for=\"petal_length\"\u003ePetal Length (cm)\u003c/label\u003e\n                        \u003cinput type=\"number\" step=\"0.1\" name=\"petal_length\" id=\"petal_length\" placeholder=\"Enter value\" required value=\"{{ inputs.petal_length if inputs else 1.4 }}\"\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class=\"input-group\"\u003e\n                        \u003clabel for=\"petal_width\"\u003ePetal Width (cm)\u003c/label\u003e\n                        \u003cinput type=\"number\" step=\"0.1\" name=\"petal_width\" id=\"petal_width\" placeholder=\"Enter value\" required value=\"{{ inputs.petal_width if inputs else 0.2 }}\"\u003e\n                    \u003c/div\u003e\n                    \u003cbutton type=\"submit\" class=\"btn-predict\"\u003eGet Inference\u003c/button\u003e\n                \u003c/form\u003e\n            \u003c/section\u003e\n\n            \u003c!-- Right Side: Real-Time Prediction \u0026 Image Output --\u003e\n            \u003csection class=\"results-panel\"\u003e\n                \u003cdiv class=\"card result-card\"\u003e\n                    \u003cdiv class=\"status-badge live\"\u003eLive Service\u003c/div\u003e\n                    \u003ch2\u003ePrediction Result\u003c/h2\u003e\n                    \n                    {% if prediction_text %}\n                        \u003cdiv class=\"prediction-output success\"\u003e\n                            \u003cspan class=\"prefix\"\u003eCLASSIFIED SPECIES:\u003c/span\u003e\n                            \u003cp class=\"species-name\"\u003e{{ species | upper }}\u003c/p\u003e\n                            {% if image_url %}\n                                \u003cdiv class=\"image-container\"\u003e\n                                    \u003cimg src=\"{{ image_url }}\" alt=\"{{ species }}\" class=\"flower-image\"\u003e\n                                \u003c/div\u003e\n                            {% endif %}\n                        \u003c/div\u003e\n                    {% else %}\n                        \u003cdiv class=\"prediction-output pending\"\u003e\n                            \u003cp\u003eSubmit features to run the ML model.\u003c/p\u003e\n                        \u003c/div\u003e\n                    {% endif %}\n                \u003c/div\u003e\n            \u003c/section\u003e\n\n        \u003c/div\u003e\n    \u003c/main\u003e\n\n    \u003cfooter class=\"app-footer\"\u003e\n        \u003cdiv class=\"container\"\u003e\n            \u003cp\u003e\u0026copy; 2026 Codec Technologies | Cloud Computing Internship Project\u003c/p\u003e\n            \u003cp class=\"tech-stack\"\u003ePowered by: Google Cloud, Python, Flask, Scikit-learn\u003c/p\u003e\n        \u003c/div\u003e\n    \u003c/footer\u003e\n\n\u003c/body\u003e\n\u003c/html\u003e"}]}
