lumns: 1fr;\n    gap: 30px;\n}\n\n@media (min-width: 768px) {\n    .main-content-layout {\n        grid-template-columns: 1.3fr 1fr;\n    }\n}\n\n/* --- Cards --- */\n.card {\n    background-color: var(--card-background);\n    padding: 30px;\n    border-radius: var(--border-radius-md);\n    box-shadow: var(--box-shadow-md);\n    border: 1px solid #e0e0e0;\n}\n\nh2 {\n    font-weight: 500;\n    font-size: 1.5rem;\n    margin-bottom: 8px;\n    color: var(--text-color);\n}\n\nsection p {\n    color: var(--text-color-muted);\n    margin-bottom: 25px;\n}\n\n/* --- Input Form --- */\n.ml-input-form .input-group {\n    margin-bottom: 18px;\n}\n\n.ml-input-form label {\n    display: block;\n    font-weight: 500;\n    margin-bottom: 6px;\n    font-size: 0.95rem;\n    color: var(--text-color);\n}\n\n.ml-input-form input {\n    width: 100%;\n    padding: 12px 15px;\n    border: 1px solid #dadce0;\n    border-radius: var(--border-radius-sm);\n    font-size: 1rem;\n    transition: var(--transition-base);\n}\n\n.ml-input-form input:focus {\n    outline: none;\n    border-color: var(--primary-color);\n    box-shadow: 0 0 0 3px rgba(26, 115, 232, 0.2);\n}\n\n.btn-predict {\n    width: 100%;\n    padding: 14px;\n    background-color: var(--primary-color);\n    color: #ffffff;\n    border: none;\n    border-radius: var(--border-radius-sm);\n    font-size: 1.1rem;\n    font-weight: 500;\n    cursor: pointer;\n    transition: var(--transition-base);\n    margin-top: 10px;\n}\n\n.btn-predict:hover {\n    background-color: var(--accent-color-hover);\n    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);\n}\n\n/* --- Results \u0026 Image Card --- */\n.result-card {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: flex-start;\n    text-align: center;\n    min-height: 320px;\n    position: relative;\n    padding-top: 50px;\n}\n\n.status-badge {\n    position: absolute;\n    top: 20px;\n    right: 20px;\n    background-color: #f1f3f4;\n    color: var(