I0916 14:01:19.785998    3827 conn_opt.go:53] jsonrpc2: --> notif: textDocument/didChange: {"textDocument":{"uri":"file:///home/sshravyaharikant/static/style.css","version":2},"contentChanges":[{"range":{"start":{"line":0,"character":0},"end":{"line":25,"character":1}},"rangeLength":536,"text":":root {\n    --primary-color: #1a73e8;\n    --accent-color-hover: #1557b0;\n    --background-color: #f8f9fa;\n    --card-background: #ffffff;\n    --text-color: #202124;\n    --text-color-muted: #5f6368;\n    --success-color: #0f9d58;\n    --pending-color: #dadce0;\n    \n    --border-radius-sm: 6px;\n    --border-radius-md: 12px;\n    --box-shadow-md: 0 4px 16px rgba(0, 0, 0, 0.08);\n    --transition-base: all 0.25s ease-in-out;\n}\n\n* {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n}\n\nbody {\n    font-family: 'Roboto', sans-serif;\n    background-color: var(--background-color);\n    color: var(--text-color);\n    line-height: 1.6;\n    display: flex;\n    flex-direction: column;\n    min-height: 100vh;\n}\n\n.container {\n    max-width: 1000px;\n    margin: 0 auto;\n    padding: 0 20px;\n    width: 100%;\n}\n\n/* --- Header \u0026 Gradient --- */\n.app-header {\n    background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);\n    color: #ffffff;\n    padding: 35px 0;\n    text-align: center;\n    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);\n}\n\n.app-header h1 {\n    font-weight: 500;\n    font-size: 2.2rem;\n    margin-bottom: 5px;\n}\n\n.app-header .subtitle {\n    font-weight: 300;\n    font-size: 1rem;\n    color: #e8f0fe;\n}\n\n.app-footer {\n    background-color: #ffffff;\n    padding: 20px 0;\n    margin-top: auto;\n    text-align: center;\n    border-top: 1px solid #dadce0;\n    font-size: 0.9rem;\n    color: var(--text-color-muted);\n}\n\n.app-footer .tech-stack {\n    font-size: 0.8rem;\n    margin-top: 5px;\n}\n\n/* --- Main Content Grid --- */\n.app-main {\n    padding: 40px 0;\n}\n\n.main-content-layout {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 30px;\n}\n\n@media (min-width: 768px) {\n    .main-content-layout {\n        grid-template-columns: 1.3fr 1fr;\n    }\n}\n\n/* --- Cards --- */\n.card {\n    background-color: var(--card-background);\n    padding: 30px;\n    border-radius: var(--border-radius-md);\n    box-shadow: var(--box-shadow-md);\n    border: 1px solid #e0e0e0;\n}\n\nh2 {\n    font-weight: 500;\n    font-size: 1.5rem;\n    margin-bottom: 8px;\n    color: var(--text-color);\n}\n\nsection p {\n    color: var(--text-color-muted);\n    margin-bottom: 25px;\n}\n\n/* --- Input Form --- */\n.ml-input-form .input-group {\n    margin-bottom: 18px;\n}\n\n.ml-input-form label {\n    display: block;\n    font-weight: 500;\n    margin-bottom: 6px;\n    font-size: 0.95rem;\n    color: var(--text-color);\n}\n\n.ml-input-form input {\n    width: 100%;\n    padding: 12px 15px;\n    border: 1px solid #dadce0;\n    border-radius: var(--border-radius-sm);\n    font-size: 1rem;\n    transition: var(--transition-base);\n}\n\n.ml-input-form input:focus {\n    outline: none;\n    border-color: var(--primary-color);\n    box-shadow: 0 0 0 3px rgba(26, 115, 232, 0.2);\n}\n\n.btn-predict {\n    width: 100%;\n    padding: 14px;\n    background-color: var(--primary-color);\n    color: #ffffff;\n    border: none;\n    border-radius: var(--border-radius-sm);\n    font-size: 1.1rem;\n    font-weight: 500;\n    cursor: pointer;\n    transition: var(--transition-base);\n    margin-top: 10px;\n}\n\n.btn-predict:hover {\n    background-color: var(--accent-color-hover);\n    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);\n}\n\n/* --- Results \u0026 Image Card --- */\n.result-card {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: flex-start;\n    text-align: center;\n    min-height: 320px;\n    position: relative;\n    padding-top: 50px;\n}\n\n.status-badge {\n    position: absolute;\n    top: 20px;\n    right: 20px;\n    background-color: #f1f3f4;\n    color: var(--text-color-muted);\n    padding: 5px 12px;\n    border-radius: 20px;\n    font-size: 0.8rem;\n    font-weight: 500;\n    border: 1px solid #dadce0;\n}\n\n.status-badge.live {\n    background-color: #e6f4ea;\n    color: var(--success-color);\n    border-color: #ceead6;\n}\n\n.prediction-output {\n    width: 100%;\n    padding: 20px;\n    border-radius: var(--border-radius-sm);\n}\n\n.prediction-output.success {\n    background-color: #e6f4ea;\n    border: 1px solid var(--success-color);\n}\n\n.prediction-output.pending {\n    background-color: #f8f9fa;\n    border: 1px solid var(--pending-color);\n    color: var(--text-color-muted);\n}\n\n.prediction-output .prefix {\n    font-size: 0.85rem;\n    color: var(--success-color);\n    letter-spacing: 0.5px;\n    font-weight: 700;\n}\n\n.prediction-output .species-name {\n    font-size: 1.8rem;\n    margin: 5px 0 15px 0;\n    color: var(--text-color);\n    font-weight: 700;\n}\n\n/* --- Image Container Styling --- */\n.image-container {\n    width: 100%;\n    height: 180px;\n    overflow: hidden;\n    border-radius: var(--border-radius-sm);\n    box-shadow: 0 4px 8px rgba(0,0,0,0.12);\n}\n\n.flower-image {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    transition: transform 0.3s ease;\n}\n\n.flower-image:hover {\n    transform: scale(1.05);\n}"}]}
