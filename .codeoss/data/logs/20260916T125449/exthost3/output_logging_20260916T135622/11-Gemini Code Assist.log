            prediction_text=f\"Predicted Species: {species}\", \n            species=species, \n            image_url=image_url, \n            inputs=inputs\n        )\n\n    except Exception as e:\n        return jsonify({\"status\": \"error\", \"message\": str(e)}), 400\n\nif __name__ == \"__main__\":\n    app.run(host=\"0.0.0.0\", port=8080, debug=True)"}
