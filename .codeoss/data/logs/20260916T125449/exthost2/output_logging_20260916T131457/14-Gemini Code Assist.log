\" required value=\"{{ inputs.sepal_length if inputs else 5.1 }}\"\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class=\"input-group\"\u003e\n                        \u003clabel for=\"sepal_width\"\u003eSepal Width (cm)\u003c/label\u003e\n                        \u003cinput type=\"number\" step=\"0.1\" name=\"sepal_width\" id=\"sepal_width\" placeholder=\"Enter value\" required value=\"{{ inputs.sepal_width if inputs else 3.5 }}\"\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class=\"input-group\"\u003e\n                        \u003clabel for=\"petal_length\"\u003ePetal Length (cm)\u003c/label\u003e\n                        \u003cinput type=\"number\" step=\"0.1\" name=\"petal_length\" id=\"petal_length\" placeholder=\"Enter value\" required value=\"{{ inputs.petal_length if inputs else 1.4 }}\"\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class=\"input-group\"\u003e\n                        \u003clabel for=\"petal_width\"\u003ePetal Width (cm)\u003c/label\u003e\n                        \u003cinput type=\"number\" step=\"0.1\" name=\"petal_width\" id=\"petal_width\" placeholder=\"Enter value\" required value=\"{{ inputs.petal_width if inputs else 0.2 }}\"\u003e\n                    \u003c/div\u003e\n                    \u003cbutton type=\"submit\" class=\"btn-predict\"\u003eGet Inference\u003c/button\u003e\n                \u003c/form\u003e\n            \u003c/section\u003e\n\n            \u003c!-- Right Side: Real-Time Prediction Results --\u003e\n            \u003csection class=\"results-panel\"\u003e\n                \u003cdiv class=\"card result-card\"\u003e\n                    \u003cdiv class=\"status-badge live\"\u003eLive Service\u003c/div\u003e\n                    \u003ch2\u003ePrediction Result\u003c/h2\u003e\n                    \n                    {% if prediction_text %}\n                        \u003cdiv class=\"prediction-output success\"\u003e\n               