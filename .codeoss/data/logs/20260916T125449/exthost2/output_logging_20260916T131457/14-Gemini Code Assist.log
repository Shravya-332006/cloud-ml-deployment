_main__\":\n    app.run(host=\"0.0.0.0\", port=8080, debug=True)"},{"isSelected":true},{}]},"otherFiles":[{"codeLanguage":"python","filePath":"model.py","includedReason":"COLOCATED","segments":[{"content":"import pickle\nfrom sklearn.datasets import load_iris\nfrom sklearn.ensemble import RandomForestClassifier\n\ndata = load_iris()\nclf = RandomForestClassifier(n_estimators=100, random_state=42)\nclf.fit(data.data, data.target)\n\nwith open(\"model.pkl\", \"wb\") as f:\n    pickle.dump((clf, data.target_names.tolist()), f)\nprint(\"Model saved to model.pkl\")"}]}]},"metadata":{"duetProject":"cloudshell-gca","ideName":"Code OSS for Cloud Shell","ideType":"CLOUD_SHELL","ideVersion":"1.123.2-cde","platform":"LINUX_AMD64","pluginType":"CLOUD_CODE","pluginVersion":"2.98.0"},"project":"cloudshell-gca","requestId":"cloudcode-969547395-5674714a-f2d9-40dc-be00-640561dec603","userContext":{}}
